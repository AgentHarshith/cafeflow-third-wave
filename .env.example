# Copy to .env for local development. Never commit .env.
# Gemini API key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to the "gemini-flash-latest" alias. Pin a specific model for
# reproducible behaviour, e.g. one listed by: python scripts/list_models.py
GEMINI_MODEL=
# Gemini 3+ reasoning effort: minimal | low | medium | high | default
GEMINI_THINKING_LEVEL=low
# Café profile from app/data/cafes/: third_wave (default) or daily_grind (fictional fallback)
CAFE_PROFILE=third_wave
APP_ENV=development
# Staff dashboard PIN (Cloud Run reads it from Secret Manager: staff-pin)
STAFF_PIN=
